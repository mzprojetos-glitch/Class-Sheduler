# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/class-scheduler?retryWrites=true&w=majority
# NextAuth (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=troque-por-um-segredo-forte
NEXTAUTH_URL=http://localhost:3000
# OAuth (opcional - botões "Entrar com Google/Apple" só funcionam se preenchidos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=
# Dados do responsável (rodapé e páginas legais - LGPD)
NEXT_PUBLIC_CONTROLLER_NAME=Seu Nome / Razão Social
NEXT_PUBLIC_CONTROLLER_DOC=CPF/CNPJ (quando aplicável)
NEXT_PUBLIC_CONTACT_EMAIL=contato@exemplo.com
